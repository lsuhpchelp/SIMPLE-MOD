#%Module

# =====================================================================
# Generated by SIMPLE-MOD
# Developer: Jason Li (jasonli3@lsu.edu)
# Description: 
#       1) This module template is compatible with:
#            - Environment Modules >= 4.5.2. 
#               See https://github.com/cea-hpc/modules
#            - Lmod >= 8.7.34. 
#               See https://github.com/TACC/Lmod
#          May not be compatible with different module systems.
#       2) This template generates wrapper scripts in users' 
#          environment, and works with MPI-enabled software packages.
# =====================================================================

# ---------------------------------------------------------------------
# Wrapper scripts path (Customize me)
# ---------------------------------------------------------------------

set WRAPPER_PATH /home/$env(USER)/.local/bin/modules

# ---------------------------------------------------------------------
# Software specific information
# ---------------------------------------------------------------------

# Module information
module-whatis Name: alphafold
module-whatis Version: 3.0.4
module-whatis Description: AlphaFold 3 inference pipeline.

# Singularity options
set SINGULARITY_IMAGE "/project/containers/images/alphafold3-3.0.4.sif"
set SINGULARITY_BINDPATHS "/work,/project,/scratch,/usr/local/packages,/var/scratch,\$AF_DB_DIR/mgy_clusters_2022_05.fa:/opt/afdata/mgy_clusters_2022_05.fa,\$AF_DB_DIR/bfd-first_non_consensus_sequences.fasta:/opt/afdata/bfd-first_non_consensus_sequences.fasta,\$AF_DB_DIR/uniref90_2022_05.fa:/opt/afdata/uniref90_2022_05.fa,\$AF_DB_DIR/uniprot_all_2021_04.fa:/opt/afdata/uniprot_all_2021_04.fa,\$AF_DB_DIR/pdb_seqres_2022_09_28.fasta:/opt/afdata/pdb_seqres_2022_09_28.fasta,\$AF_DB_DIR/rnacentral_active_seq_id_90_cov_80_linclust.fasta:/opt/afdata/rnacentral_active_seq_id_90_cov_80_linclust.fasta,\$AF_DB_DIR/nt_rna_2023_02_23_clust_seq_id_90_cov_80_rep_seq.fasta:/opt/afdata/nt_rna_2023_02_23_clust_seq_id_90_cov_80_rep_seq.fasta,\$AF_DB_DIR/rfam_14_9_clust_seq_id_90_cov_80_rep_seq.fasta:/opt/afdata/rfam_14_9_clust_seq_id_90_cov_80_rep_seq.fasta"
set SINGULARITY_FLAGS "--nv"

# Conflicts
conflict alphafold 

# List of commands to overwrite
set CMDS {
run_alphafold.sh
}

# Set environment varialbles
setenv AF_DB_DIR "/project/containers/images/.afdata/"


# ---------------------------------------------------------------------
# Module key setup
# ---------------------------------------------------------------------

# Combine Singularity exec command
set SINGULARITY_EXEC "singularity exec -B $SINGULARITY_BINDPATHS $SINGULARITY_FLAGS --pwd \$PWD $SINGULARITY_IMAGE"

# Set wrapper directory
file mkdir $WRAPPER_PATH/alphafold/3.0.4
prepend-path PATH $WRAPPER_PATH/alphafold/3.0.4

# Create wrappers when the module is loaded
if { [ module-info mode load ] } {

    # If it is csh type shell
    if { [module-info shelltype] == "csh" } {
    
        # Create wrappers for each command
        foreach cmd $CMDS {
            puts "echo '#\\!/bin/bash' > $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
            puts "echo '$SINGULARITY_EXEC $cmd \"$@\"' >> $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
            puts "chmod u+x $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
        }
        
        # Refresh cache (only for csh type shell)
        puts "rehash;"
        
    # If it is sh type shell
    } elseif { [module-info shelltype] == "sh" } {
    
        # Create wrappers for each command
        foreach cmd $CMDS {
            puts "echo '#!/bin/bash' > $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
            puts "echo '$SINGULARITY_EXEC $cmd \"$@\"' >> $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
            puts "chmod u+x $WRAPPER_PATH/alphafold/3.0.4/$cmd;"
        }
        
    }
}

# Currently, wrappers will not be deleted to avoid unwanted issues.

# Help information
proc ModulesHelp {} {
    global CMDS
    puts stderr "

\[ Help information \]

1. This module only works on computing nodes (not available on head nodes). Make sure you start a job!

2. By continue using AlphaFold 3, you agree that you have read and will comply with AlphaFold 3 Model Parameters Terms of Use (https://github.com/google-deepmind/alphafold3/blob/main/WEIGHTS_TERMS_OF_USE.md).

3. Please do not use the Python script offered on the official website https://github.com/google-deepmind/alphafold3. Instead, please use wrapper command 'run_alphafold.sh':

    run_alphafold.sh \[options\]

For example:

    run_alphafold.sh --json_path=/path/to/input.json --output_dir=/path/to/output/folder

4. You do not need to pass '--model_dir' and '--db_dir', as model weight and database are already configured.

5. AlphaFold 3 module has been tested with CPUs and A100 GPUs. Older GPUs like V100 and V100S may not work properly.
"
}
if { [ module-info mode load ] } {
    ModulesHelp
}
